    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="DataBase\WatchListDataBase.accdb" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="DataBase\WatchListDataBase.accdb">
